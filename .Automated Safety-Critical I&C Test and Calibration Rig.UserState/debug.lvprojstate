          <SignalUID value="4780"/>
          <SignalUID value="6892"/>
          <SignalUID value="5691"/>
          <SignalUID value="5605"/>
          <SignalUID value="5704"/>
        </Generic>
      </Probes>
    </VI>
    <VI name="Database.lvlib:Fetch DB List.vi">
