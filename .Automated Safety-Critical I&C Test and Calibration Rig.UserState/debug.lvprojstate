<Configuration>
  <Target name="My Computer">
    <EnableDebuggingForAllVIs>0</EnableDebuggingForAllVIs>
    <VI name="Acquisition.lvlib:Acquisition Message Loop.vi">
      <Breakpoints>
        <NodeIndexes>
        </NodeIndexes>
        <SignalIndexes>
        </SignalIndexes>
      </Breakpoints>
      <Probes>
        <Generic>
          <SignalUID value="2735"/>
          <SignalUID value="2194"/>
          <SignalUID value="2356"/>
        </Generic>
      </Probes>
    </VI>
    <VI name="Acquisition.lvlib:Initialize Hardware References.vi">
      <Breakpoints>
        <NodeIndexes>
        </NodeIndexes>
        <SignalIndexes>
        </SignalIndexes>
      </Breakpoints>
      <Probes>
        <Generic>
          <SignalUID value="1935"/>
          <SignalUID value="1947"/>
          <SignalUID value="965"/>
          <SignalUID value="859"/>
          <SignalUID value="875"/>
          <SignalUID value="910"/>
          <SignalUID value="557"/>
          <SignalUID value="574"/>
        </Generic>
      </Probes>
    </VI>
    <VI name="Check Loop Error.vi:760002">
      <Breakpoints>
